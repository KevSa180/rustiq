// Paso 11: el programa de ejemplo del documento de la gramática (+ prints)
// Salida esperada:
// 200
// 4.0
// 3.0
// 20
// true
// R
struct Punto {
    x: f64,
    y: f64,
}

enum Estado {
    Pendiente,
    Completado(i32),
    Error(String),
}

fn mover_x(p: &mut Punto, dx: f64) {
    p.x = p.x + dx;
}

fn describir(estado: Estado) -> i32 {
    match estado {
        Estado::Pendiente => 0,
        Estado::Completado(codigo) => codigo,
        Estado::Error(_) => -1,
    }
}

fn main() {
    let mut p = Punto { x: 1.0, y: 2.0 };
    mover_x(&mut p, 3.0);

    let estado = Estado::Completado(200);
    let codigo = describir(estado);

    let dimensiones: (f64, f64) = (p.x, p.y);
    let muestras: [i32; 3] = [10, 20, 30];
    let correcto: bool = codigo == 200;
    let inicial: char = 'R';

    if correcto {
        p.y = p.y + 1.0;
    }

    print_i32(codigo);
    print_f64(p.x);
    print_f64(p.y);
    print_i32(muestras[1]);
    print_bool(correcto);
    print_char(inicial);
}
