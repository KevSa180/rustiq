// Error esperado: semántico 10:5 El match no es exhaustivo: no se cubre el patrón 'Estado::Error(_)'
enum Estado {
    Pendiente,
    Completado(i32),
    Error(String),
}

fn main() {
    let e = Estado::Pendiente;
    match e {
        Estado::Pendiente => print_i32(0),
        Estado::Completado(c) => print_i32(c),
    };
}
